# =====================================================================
# Normalisation des fins de ligne
#
# Sans ce fichier, Git voyait ~90 fichiers comme "modifiés" alors que
# seuls leurs retours à la ligne avaient changé (CRLF Windows vs LF).
#
# Règle : dans le dépôt, tout est stocké en LF. Sur le disque Windows,
# Git rend les fichiers dans le format attendu par les outils.
# =====================================================================

* text=auto eol=lf

# --- Scripts Windows : doivent rester en CRLF ---
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# --- Fichiers binaires : Git ne doit jamais y toucher ---
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.webp         binary
*.svg          text
*.ttf          binary
*.otf          binary
*.woff         binary
*.woff2        binary
*.pdf          binary
*.zip          binary
*.jar          binary
*.keystore     binary
*.jks          binary
*.p12          binary
*.mobileprovision binary

# --- Fichiers Flutter/Dart ---
*.dart   text
*.yaml   text
*.yml    text
*.json   text
*.md     text
*.sql    text
